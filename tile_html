<!-- TILE ESTÀNDARD COMPLET - ORGANITZACIONS -->
<a href="{{ url_for('organitzacions.llistat') }}" class="boto-principal">
  <svg viewBox="0 0 150 150" xmlns="http://www.w3.org/2000/svg">
    
    <!-- Forma principal (fons neutre) -->
    <path d="M10,20 Q75,0 140,20 L140,130 Q75,150 10,130 Z"
          fill="#f5f5f5" stroke="none"/>

    <!-- Definicions úniques per aquest tile -->
    <defs>
      <!-- Gradient amb brillantor al centre -->
      <linearGradient id="grad-org" x1="0%" y1="0%" x2="0%" y2="100%">
        <stop offset="0%" stop-color="#14d8ce"/>
        <stop offset="45%" stop-color="#0e9f94"/>
        <stop offset="50%" stop-color="#ffffff" stop-opacity="0.6"/> <!-- brillantor -->
        <stop offset="55%" stop-color="#0e9f94"/>
        <stop offset="100%" stop-color="#14d8ce"/>
      </linearGradient>

      <!-- ClipPath superior per imatge -->
      <clipPath id="clip-top-org">
        <path d="M10,20 Q75,0 140,20 L140,95 L10,95 Z"/>
      </clipPath>

      <!-- ClipPath inferior per gradient -->
      <clipPath id="clip-bottom-org">
        <path d="M10,95 L140,95 L140,130 Q75,150 10,130 Z"/>
      </clipPath>
    </defs>

    <!-- Zona superior amb imatge -->
    <image href="{{ url_for('static', filename='img/organitzacions.png') }}"
           x="10" y="0" width="130" height="100"
           preserveAspectRatio="xMidYMid slice" clip-path="url(#clip-top-org)"/>

    <!-- Zona inferior amb gradient arrodonit -->
    <rect x="10" y="95" width="130" height="55"
          fill="url(#grad-org)" clip-path="url(#clip-bottom-org)"/>

    <!-- Text -->
    <text x="75" y="120" text-anchor="middle" font-size="14"
          font-family="Montserrat" fill="#fff">
      {{ _('Organitzacions') }}
    </text>

  </svg>
</a>

