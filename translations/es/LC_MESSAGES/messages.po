#: templates/aportacions.html:3 templates/aportacions.html:156
msgid "Aportacions Voluntàries"
msgstr "Aportaciones voluntarias"

#: templates/aportacions.html:157
msgid "Un projecte independent i ètic, finançat per la comunitat"
msgstr "Un proyecto independiente y ético, financiado por la comunidad"

#: templates/aportacions.html:160
#, python-format
msgid "Adabida és i serà sempre 100% gratuït per a tothom."
msgstr "Adabida es y será siempre 100% gratuito para todo el mundo."

#: templates/aportacions.html:161
msgid ""
"No hi ha subscripcions. No hi ha funcionalitats de pagament. No hi ha "
"publicitat. No venem les teves dades."
msgstr ""
"No hay suscripciones. No hay funciones de pago. No hay publicidad. No "
"vendemos tus datos."

#: templates/aportacions.html:164
msgid "1. Per què aportacions voluntàries?"
msgstr "1. ¿Por qué aportaciones voluntarias?"

#: templates/aportacions.html:166
msgid ""
"Adabida no és només un projecte tecnològic, és un projecte amb valors. "
"Hem escollit el model d'aportacions voluntàries per raons ètiques "
"fonamentals:"
msgstr ""
"Adabida no es solo un proyecto tecnológico, es un proyecto con valores. "
"Hemos elegido el modelo de aportaciones voluntarias por razones éticas "
"fundamentales:"

#: templates/aportacions.html:169
#, fuzzy
msgid "Independència:"
msgstr "Independencia:"

#: templates/aportacions.html:169
msgid "No dependre de grans corporacions tecnològiques ni inversors"
msgstr "No depender de grandes corporaciones tecnológicas ni inversores"

#: templates/aportacions.html:170
msgid "Privacitat:"
msgstr "Privacidad:"

#: templates/aportacions.html:170
msgid "Les teves dades MAI seran el producte. Mai les vendrem ni les monetitzarem"
msgstr ""
"Tus datos NUNCA serán el producto. Nunca los venderemos ni los "
"monetizaremos"

#: templates/aportacions.html:171
msgid "Accessibilitat universal:"
msgstr "Accesibilidad universal:"

#: templates/aportacions.html:171
msgid ""
"Qualsevol persona ha de poder preservar la seva memòria, independentment "
"dels seus recursos econòmics"
msgstr ""
"Cualquier persona debe poder preservar su memoria, independientemente de "
"sus recursos económicos"

#: templates/aportacions.html:172
msgid "Dignitat:"
msgstr "Dignidad:"

#: templates/aportacions.html:172
msgid "Els records i testimonis de les persones no són una mercaderia"
msgstr "Los recuerdos y testimonios de las personas no son una mercancía"

#: templates/aportacions.html:173
msgid "Comunitat:"
msgstr "Comunidad:"

#: templates/aportacions.html:173
msgid "El projecte és de tots i per a tots, no d'una empresa amb ànim de lucre"
msgstr "El proyecto es de todos y para todos, no de una empresa con ánimo de lucro"

#: templates/aportacions.html:176
msgid ""
"Inspirats en projectes com Wikipedia, creiem que el coneixement i la "
"memòria col·lectiva han de ser lliures i accessibles. Però això té un "
"cost."
msgstr ""
"Inspirados en proyectos como Wikipedia, creemos que el conocimiento y la "
"memoria colectiva deben ser libres y accesibles. Pero esto tiene un "
"coste."

#: templates/aportacions.html:178
msgid "2. Transparència financera"
msgstr "2. Transparencia financiera"

#: templates/aportacions.html:180
msgid ""
"Ens comprometem a la transparència total. Cada euro que aportes es "
"destina a mantenir i millorar Adabida:"
msgstr ""
"Nos comprometemos a la transparencia total. Cada euro que aportas se "
"destina a mantener y mejorar Adabida:"

#: templates/aportacions.html:185
#, fuzzy
msgid "Concepte"
msgstr "Concepto"

#: templates/aportacions.html:186
msgid "Cost estimat/any"
msgstr "Coste estimado/año"

