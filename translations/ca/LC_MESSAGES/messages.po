#: templates/aportacions.html:27 templates/nova_aportacio_inici.html:26
msgid "No dependre de grans corporacions tecnològiques ni inversors"
msgstr ""

#: templates/aportacions.html:28 templates/nova_aportacio_inici.html:27
msgid "Privacitat:"
msgstr ""

#: templates/aportacions.html:28 templates/nova_aportacio_inici.html:27
msgid "Les teves dades MAI seran el producte. Mai les vendrem ni les monetitzarem"
