msgid "Ets investigador, periodista o professional i vols col·laborar amb Adabida?"
msgstr "Ви дослідник, журналіст або фахівець і хочете співпрацювати з Adabida?"

msgid "Proposta col·laboració"
msgstr "Пропозиція співпраці"

msgid "Proposar col·laboració"
msgstr "Запропонувати співпрацю"

